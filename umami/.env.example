# Umami 环境变量模板
# 复制为 .env 并替换为真实随机值（在服务器上执行：
#   printf 'APP_SECRET=%s\nPOSTGRES_PASSWORD=%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 16)" > .env
# 此文件是模板，真实 .env 绝不提交到 git）

# 用于签发登录会话 token 的密钥（改成你自己的 64 位随机 hex）
APP_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# PostgreSQL 密码（改成你自己的 32 位随机 hex）
POSTGRES_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_16
